# Application
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Database — required. Matches the docker-compose `postgres` service defaults.
# Host port defaults to 5433 (not 5432) to avoid colliding with a locally
# installed PostgreSQL service, if one is already running on this machine.
DATABASE_URL=postgresql://saathiride:saathiride@localhost:5433/saathiride
POSTGRES_USER=saathiride
POSTGRES_PASSWORD=saathiride
POSTGRES_DB=saathiride
POSTGRES_PORT=5433

# Redis — required. Matches the docker-compose `redis` service defaults.
# Host port defaults to 6380 (not 6379) to avoid colliding with another
# Redis instance, if one is already running on this machine (e.g. via WSL).
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Auth — required. Never use this placeholder value outside local development.
JWT_ACCESS_SECRET=change-me-in-every-real-environment
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_IP_MAX=10
OTP_VERIFY_IP_MAX=10

# Brevo (email/OTP delivery) — optional; without it, OTPs print to stdout via
# ConsoleEmailProvider (development only, never safe in production).
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=

# Cloudinary (document storage) — optional for local development. Unlike
# email, there is no safe fallback: without these, document upload endpoints
# fail at call time with 503 SERVICE_UNAVAILABLE rather than at boot.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Cloudinary Auth Token key — separate from the credentials above, needed
# for genuinely time-boxed signed document URLs. Requires the Cloudinary
# account's own Auth Token / "Strict transformations" security setting to be
# enabled first (dashboard-side). Without it, delivery falls back to a
# signed-but-non-expiring URL.
# CLOUDINARY_AUTH_TOKEN_KEY=
DOCUMENT_SIGNED_URL_TTL_SECONDS=300

# Geoapify (maps: geocoding, routing, distance matrix) — optional for local
# development. Unlike email, there is no safe fallback: without a key,
# GeoapifyMapProvider fails at call time with 503 SERVICE_UNAVAILABLE rather
# than at boot. Free tier is credit-limited per day.
MAP_PROVIDER=geoapify
# MAP_PROVIDER_API_KEY=

# Fare engine — every input is configuration, never hard-coded. Defaults
# match the documented formula (architecture.md §12); uncomment to override.
# FARE_BASE_FARE=30
# FARE_PRICE_PER_KM=8
# FARE_VEHICLE_MULTIPLIER_HATCHBACK=1.0
# FARE_VEHICLE_MULTIPLIER_SEDAN=1.15
# FARE_VEHICLE_MULTIPLIER_MUV=1.3
# FARE_VEHICLE_MULTIPLIER_SUV=1.35
# FARE_TRAFFIC_MULTIPLIER_MIN=0.8
# FARE_TRAFFIC_MULTIPLIER_MAX=2.0
# FARE_RATING_MULTIPLIER_MIN=0.95
# FARE_RATING_MULTIPLIER_MAX=1.05

# Ride search — the largest page a client can get; a bigger `limit` is
# silently clamped to this rather than rejected. Uncomment to override.
# RIDE_SEARCH_MAX_LIMIT=50

# How long (seconds) a PENDING_PAYMENT booking holds its seats before the
# seat-hold expiry job releases them if payment never completes.
# BOOKING_PAYMENT_TTL_SECONDS=900

# Razorpay (payment gateway) — optional for local development. Unlike email,
# there is no safe fallback: without the key/secret pair, StubPaymentProvider
# is used (fake order ids, no money moves — unsafe in production).
# PAYMENT_PROVIDER_KEY=
# PAYMENT_PROVIDER_SECRET=
# A separate credential — Razorpay signs webhook deliveries with its own
# secret. Used by both providers' verifyWebhookSignature.
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
