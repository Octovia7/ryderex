# Application
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Database — required. Matches the docker-compose `postgres` service defaults.
# Host port defaults to 5433 (not 5432) to avoid colliding with a locally
# installed PostgreSQL service, if one is already running on this machine.
DATABASE_URL=postgresql://saathiride:saathiride@localhost:5433/saathiride
POSTGRES_USER=saathiride
POSTGRES_PASSWORD=saathiride
POSTGRES_DB=saathiride
POSTGRES_PORT=5433

# Redis — required. Matches the docker-compose `redis` service defaults.
# Host port defaults to 6380 (not 6379) to avoid colliding with another
# Redis instance, if one is already running on this machine (e.g. via WSL).
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Auth — required. Never use this placeholder value outside local development.
JWT_ACCESS_SECRET=change-me-in-every-real-environment
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_IP_MAX=10
OTP_VERIFY_IP_MAX=10

# Brevo (email/OTP delivery) — optional; without it, OTPs print to stdout via
# ConsoleEmailProvider (development only, never safe in production).
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
