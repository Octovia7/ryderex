# Base URL of the SaathiRide backend's API, including the /api/v1 prefix.
# No trailing slash. Not a secret — this is just where the frontend sends
# requests.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Geoapify API key, used directly from the browser for location-search
# autocomplete (src/api/places.ts calls api.geoapify.com with it as a plain
# query parameter — it is visible in every page's network requests by
# design, not a server secret). Optional: without it, location search is
# simply reported as unavailable in the UI; nothing else breaks. Get a free
# key at https://www.geoapify.com/.
VITE_GEOAPIFY_API_KEY=
