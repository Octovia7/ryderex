generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum VehicleType {
  HATCHBACK
  SEDAN
  MUV
  SUV

  @@map("vehicle_type")
}

enum VehicleStatus {
  ACTIVE
  INACTIVE

  @@map("vehicle_status")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum DriverLicenseStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("driver_license_status")
}

enum UserDocumentType {
  DRIVER_LICENSE

  @@map("user_document_type")
}

enum VehicleDocumentType {
  RC
  INSURANCE
  POLLUTION

  @@map("vehicle_document_type")
}

// One status column for the whole ride lifecycle. PENDING_PAYMENT exists
// because the driver's posting commission is confirmed asynchronously, so a
// ride cannot be searchable inside the request that created it.
enum RideStatus {
  PENDING_PAYMENT
  OPEN
  FULL
  STARTED
  COMPLETED
  CANCELLED

  @@map("ride_status")
}

// One status column for the whole booking lifecycle — never split into a
// booking status plus a payment status. Seat holds are PENDING_PAYMENT rows.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PAYMENT_FAILED
  CANCELLED
  COMPLETED

  @@map("booking_status")
}

// A gateway attempt's own lifecycle — separate from whatever the Ride/Booking
// it funds is doing. Only a signature-verified webhook (a later step) ever
// moves this past CREATED.
enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED

  @@map("payment_status")
}

// A closed enum on purpose (architecture.md §11): the business record types
// this system ever produces. FINAL_PAYMENT (ride completion) and REFUND
// (cancellation) have no producer yet — declared now so the schema never
// needs a migration just to add a type this phase already anticipates.
enum TransactionType {
  DRIVER_RIDE_FEE
  BOOKING_PREPAYMENT
  FINAL_PAYMENT
  REFUND

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  // Claimed by exactly one refund attempt (refundService.processRefund's
  // atomic PENDING -> PROCESSING conditional UPDATE) — never set on the
  // original DRIVER_RIDE_FEE/BOOKING_PREPAYMENT/FINAL_PAYMENT transactions,
  // which resolve straight from PENDING to SUCCESS/FAILED via the webhook.
  // A caller that loses the claim (transaction not PENDING) never calls the
  // provider. On provider failure, the same caller reverts PROCESSING back
  // to PENDING so BullMQ's own retry/backoff gets another attempt.
  PROCESSING
  SUCCESS
  FAILED

  @@map("transaction_status")
}

// The platform a registration token was issued for — informational only
// today (nothing branches on it yet), but part of what a client supplies
// when registering a device (architecture.md §5/§15).
enum DevicePlatform {
  ANDROID
  IOS
  WEB

  @@map("device_platform")
}

// A closed enum on purpose, the same discipline as TransactionType: the nine
// business events this system ever notifies about (architecture.md §15).
enum NotificationType {
  RIDE_BOOKED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  RIDE_CANCELLED
  RIDE_STARTING
  RIDE_COMPLETED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REFUND_PROCESSED

  @@map("notification_type")
}

// `RESOLVED`/`ESCALATED` plus SupportConversation's escalationReason/
// escalatedAt exist so a future human-support queue needs no migration
// (architecture.md §17). No escalation (or resolution) flow is
// implemented — nothing sets either status today; every conversation stays
// OPEN.
enum SupportConversationStatus {
  OPEN
  RESOLVED
  ESCALATED

  @@map("support_conversation_status")
}

// SYSTEM exists in the schema for a future system-authored row (e.g. a
// persisted system prompt) but nothing creates one today — the system
// prompt is passed to the provider as `systemInstruction`, never as a
// message row, the same "schema holds a decision without the workflow"
// shape as SupportConversationStatus.ESCALATED.
enum SupportMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL

  @@map("support_message_role")
}

// A turn that fails at the provider still persists an ASSISTANT row — with
// no content — so the user's own message is never lost (architecture.md
// §17). COMPLETED is every other message; FAILED marks that one.
enum SupportMessageStatus {
  COMPLETED
  FAILED

  @@map("support_message_status")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique
  phone String @unique
  name  String

  profileImageUrl String? @map("profile_image_url")

  role   UserRole   @default(PASSENGER)
  status UserStatus @default(ACTIVE)

  // Reputation is role-scoped: a nullable average means "unrated", never "bad".
  // The driver figure is what the fare multiplier and search sort read; the
  // passenger figure is never blended into it.
  driverRatingAverage    Decimal? @map("driver_rating_average") @db.Decimal(3, 2)
  driverRatingCount      Int      @default(0) @map("driver_rating_count")
  passengerRatingAverage Decimal? @map("passenger_rating_average") @db.Decimal(3, 2)
  passengerRatingCount   Int      @default(0) @map("passenger_rating_count")

  // Nullable: null means "never applied". Only an admin approval flips
  // PASSENGER -> DRIVER; there is no self-serve upgrade.
  driverLicenseStatus          DriverLicenseStatus? @map("driver_license_status")
  driverLicenseVerifiedBy      String?              @map("driver_license_verified_by") @db.Uuid
  driverLicenseVerifiedAt      DateTime?            @map("driver_license_verified_at") @db.Timestamptz(3)
  driverLicenseRejectionReason String?              @map("driver_license_rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens              RefreshToken[]
  documents                  UserDocument[]
  vehicles                   Vehicle[]             @relation("VehicleOwner")
  verifiedVehicles           Vehicle[]             @relation("VehicleVerifier")
  driverLicenseVerifier      User?                 @relation("DriverLicenseVerifier", fields: [driverLicenseVerifiedBy], references: [id], onDelete: SetNull)
  driverLicenseVerifications User[]                @relation("DriverLicenseVerifier")
  ridesDriven                Ride[]                @relation("RideDriver")
  bookings                   Booking[]             @relation("BookingPassenger")
  idempotencyKeys            IdempotencyKey[]
  devices                    UserDevice[]
  notifications              Notification[]
  conversationsAsDriver      Conversation[]        @relation("ConversationDriver")
  conversationsAsPassenger   Conversation[]        @relation("ConversationPassenger")
  messagesSent               Message[]
  supportConversations       SupportConversation[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceId  String?   @map("device_id")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserDocument {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  documentType       UserDocumentType @map("document_type")
  cloudinaryPublicId String           @map("cloudinary_public_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_documents")
}

model Vehicle {
  id                 String      @id @default(uuid()) @db.Uuid
  ownerId            String      @map("owner_id") @db.Uuid
  registrationNumber String      @unique @map("registration_number")
  vehicleType        VehicleType @map("vehicle_type")
  seatCapacity       Int         @map("seat_capacity")

  // Shown to passengers in ride search results. Optional on purpose: a driver
  // can register a vehicle without them, so existing vehicles stay valid
  // (model unknown, is_ac false until the driver says otherwise).
  model String?
  isAc  Boolean @default(false) @map("is_ac")

  // Two independent lifecycles, deliberately not one status column:
  // `status` is the vehicle's own operational state, `verificationStatus`
  // is the admin trust decision. Ride-creation eligibility reads both.
  status             VehicleStatus      @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  rejectionReason    String?            @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User  @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  verifier User? @relation("VehicleVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  documents VehicleDocument[]
  rides     Ride[]

  @@index([ownerId])
  @@map("vehicles")
}

model VehicleDocument {
  id                 String              @id @default(uuid()) @db.Uuid
  vehicleId          String              @map("vehicle_id") @db.Uuid
  documentType       VehicleDocumentType @map("document_type")
  cloudinaryPublicId String              @map("cloudinary_public_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_documents")
}

model Ride {
  id        String @id @default(uuid()) @db.Uuid
  driverId  String @map("driver_id") @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid

  // Prisma Client has no native geography type, so these are written and
  // read (ST_MakePoint / ST_X / ST_Y) by raw SQL confined to rideRepository.
  // Their GiST indexes are hand-added to the migration SQL — Prisma cannot
  // declare an @@index on an Unsupported field, and will propose DROPping
  // them on any later migration touching this table (strip those lines).
  origin      Unsupported("geography(Point,4326)")
  destination Unsupported("geography(Point,4326)")

  departureTime  DateTime @map("departure_time") @db.Timestamptz(3)
  totalSeats     Int      @map("total_seats")
  availableSeats Int      @map("available_seats")

  // Computed once at creation and never recalculated from current config, so
  // a pricing change only ever affects new rides.
  farePerSeat             Decimal @map("fare_per_seat") @db.Decimal(10, 2)
  postingCommissionAmount Decimal @map("posting_commission_amount") @db.Decimal(10, 2)

  // The route as returned by the map provider when the ride was created:
  // every coordinate ([{ lat, lng }, ...]), plus its length and duration.
  routeGeometry        Json @map("route_geometry")
  routeDistanceMeters  Int  @map("route_distance_meters")
  routeDurationSeconds Int  @map("route_duration_seconds")

  // The payment provider's reference for the driver's posting-commission
  // order. Payment/Transaction rows do not exist yet, so it lives here.
  paymentOrderId String @map("payment_order_id")

  status RideStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver   User      @relation("RideDriver", fields: [driverId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookings Booking[]

  payments      Payment[]
  transactions  Transaction[]
  conversations Conversation[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([departureTime, status])
  @@map("rides")
}

// A passenger's claim on some of a ride's seats. The seat hold IS this row
// (in PENDING_PAYMENT) plus the `available_seats` decrement that created it —
// there is no Redis counter and no separate reservation table.
model Booking {
  id          String @id @default(uuid()) @db.Uuid
  rideId      String @map("ride_id") @db.Uuid
  passengerId String @map("passenger_id") @db.Uuid

  seats Int

  // Copied from the ride's persisted fare at creation and never recalculated,
  // so a later pricing change cannot alter what an existing booking owes.
  farePerSeat   Decimal @map("fare_per_seat") @db.Decimal(10, 2)
  totalFare     Decimal @map("total_fare") @db.Decimal(10, 2)
  prepaidAmount Decimal @map("prepaid_amount") @db.Decimal(10, 2)

  // Plain latitude/longitude — bookings need no spatial queries, so unlike
  // rides they are not PostGIS geography. Default to the ride's own origin
  // and destination when the passenger supplies no coordinates of their own.
  pickupLat Float @map("pickup_lat")
  pickupLng Float @map("pickup_lng")
  dropLat   Float @map("drop_lat")
  dropLng   Float @map("drop_lng")

  status BookingStatus @default(PENDING_PAYMENT)

  // The payment provider's reference for the prepayment order. Null between the
  // booking committing and the order being attached — the order is created
  // AFTER the seat-reservation transaction, never inside it.
  paymentOrderId String? @map("payment_order_id")

  // The same pattern, for the remaining-90% order created at ride completion
  // (steps.md §12). Null until rideService.completeRide's follow-up creates
  // one; staying null is also the idempotency guard against re-creating a
  // second order if createFinalPaymentOrdersForRide is ever re-invoked.
  finalPaymentOrderId String? @map("final_payment_order_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ride      Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger User @relation("BookingPassenger", fields: [passengerId], references: [id], onDelete: Cascade)

  payments     Payment[]
  transactions Transaction[]

  @@index([rideId])
  @@index([passengerId])
  @@map("bookings")
}

// A gateway attempt: which provider, its order/payment ids, the amount, and
// its own CREATED -> SUCCESS|FAILED lifecycle — kept separate from whatever
// business state the Ride/Booking it funds is in (architecture.md §11,
// "Gateway-level detail lives on the Payment row's own status").
//
// Exactly one of rideId/bookingId is set, matching the ERD (Ride --o{ Payment
// "posting fee", Booking --o{ Payment "prepayment + final") — never both,
// never neither. Nothing enforces that at the database level (there is no
// CHECK constraint), because the only writer is paymentRecordService.recordOrder,
// which always supplies exactly one; this is the same trust boundary as
// Booking.paymentOrderId, written by exactly one function.
model Payment {
  id        String  @id @default(uuid()) @db.Uuid
  rideId    String? @map("ride_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid

  provider String

  // Unique so a webhook (a later step) can look up the Payment it resolves by
  // this id alone (claude.md §6's load-bearing constraint list).
  providerOrderId   String  @unique @map("provider_order_id")
  providerPaymentId String? @map("provider_payment_id")

  amount Decimal       @db.Decimal(10, 2)
  status PaymentStatus @default(CREATED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // SetNull, not Cascade (architecture.md §6): financial history outlives
  // whatever it refers to. Neither Ride nor Booking is ever deleted by any
  // code path today, so this is defensive, not exercised.
  ride         Ride?         @relation(fields: [rideId], references: [id], onDelete: SetNull)
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([rideId])
  @@index([bookingId])
  @@map("payments")
}

// The business record a Payment attempt produces: what it was for (`type`),
// how much, and its own PENDING -> SUCCESS|FAILED lifecycle — a reconciliation
// history, not a success log, since a FAILED attempt gets a Transaction row
// too (architecture.md §11).
//
// rideId/bookingId are denormalized copies of the parent Payment's — reads
// never need to join through Payment to find "every transaction for this
// ride" — carried at creation time by paymentRecordService.recordOrder, the
// one function that writes both rows together, so they cannot drift.
model Transaction {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  rideId    String? @map("ride_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid

  type   TransactionType
  amount Decimal           @db.Decimal(10, 2)
  status TransactionStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Cascade: a Transaction has no meaning without the Payment attempt it
  // records — unlike the Ride/Booking references below, it is never optional.
  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  ride    Ride?    @relation(fields: [rideId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([rideId])
  @@index([bookingId])
  @@map("transactions")
}

// The database-arbitrated claim behind the Idempotency-Key middleware
// (architecture.md §11 "Client-facing idempotency keys"): the `(user_id,
// key)` UNIQUE constraint is what makes two concurrent requests with the
// same key unable to both win — claimed via `createMany({ skipDuplicates:
// true })`, never a read-then-write.
//
// `responseStatus`/`responseBody` start null (still running) and are filled
// in once, after the handler produces a response — a request with the same
// key and the same `requestHash` while they are still null is IN_PROGRESS;
// once filled, it is a replay. A different `requestHash` under the same key
// is a CONFLICT regardless of either field.
model IdempotencyKey {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  key    String

  // sha256(method:path:JSON(body)) — never the raw body itself, so this
  // column stays a fixed, non-sensitive size regardless of request payload.
  requestHash String @map("request_hash")

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("idempotency_keys")
}

// One row per registered FCM registration token (architecture.md §5/§15).
// `deviceToken` is globally UNIQUE, not scoped to a user — a physical device
// has one owner at a time; a different account logging in on the same
// device reassigns it via upsert-by-token, it does not create a second row.
//
// The one exception to "no soft deletion" (architecture.md §6): an
// FCM-invalidated token is genuinely removed, not marked with a status —
// `user_devices` has no status column in this schema, and a dead
// registration token is not history worth keeping.
model UserDevice {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  deviceToken String         @unique @map("device_token")
  platform    DevicePlatform

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

// The in-app notification history — persisted independently of whether push
// delivery ever succeeds (architecture.md §15: "Persistence and delivery are
// separate concerns... a push failure can never prevent the in-app row from
// existing"). `id` is NOT database-generated: it is minted by the producer
// at *enqueue* time and passed in, so the delivery worker's own persistence
// step (`upsert` by this same id) is idempotent across BullMQ retries — an
// id generated inside the worker would differ on every attempt and produce
// duplicate rows instead.
//
// `title`/`body` are stored copies of what was (or will be) pushed, per
// notificationService's "each NotificationType owns its own title/body
// copy" — not a foreign-key reference to whatever triggered it, so the
// history keeps reading correctly even if the underlying ride/booking is
// later modified.
model Notification {
  id     String           @id @db.Uuid
  userId String           @map("user_id") @db.Uuid
  type   NotificationType

  title String
  body  String

  // Null means unread. Set once, to the first read; a second mark-read call
  // is idempotent — it never overwrites an already-set value.
  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// One conversation per (ride, passenger) pair, never one shared room per
// ride (steps.md §14: the driver talks to each passenger separately).
// Created lazily by bookingService.createBooking, the first time a given
// passenger has a reason to talk to the ride's driver — idempotent via the
// unique constraint below (architecture.md §6/claude.md §5: "unique
// constraint as arbiter"), never a check-then-insert. `driverId` is
// denormalized from `ride.driverId` at creation time — a ride's driver never
// changes post-creation, so this can never go stale, and authorization
// checks never need to join through Ride to learn who the driver is.
model Conversation {
  id          String @id @default(uuid()) @db.Uuid
  rideId      String @map("ride_id") @db.Uuid
  driverId    String @map("driver_id") @db.Uuid
  passengerId String @map("passenger_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ride      Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver    User      @relation("ConversationDriver", fields: [driverId], references: [id], onDelete: Cascade)
  passenger User      @relation("ConversationPassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([rideId, passengerId])
  @@index([driverId])
  @@index([passengerId])
  @@map("conversations")
}

// A single chat message, sent over WebSocket only (no REST POST-message
// endpoint exists — steps.md §14). `readAt` exists on the schema (the
// conceptual model calls for it) but nothing in this phase ever sets it: no
// read-receipt flow is specified for chat, unlike notifications' explicit
// PATCH .../read.
model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  senderId       String @map("sender_id") @db.Uuid

  content String

  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// The AI support chatbot's own conversation — entirely separate from
// Conversation/Message above: different module, different transport (HTTP
// only, no Socket.IO), no shared code (architecture.md §17: "Not the
// driver↔passenger chat — different module, tables, transport").
model SupportConversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  status SupportConversationStatus @default(OPEN)

  escalationReason String?   @map("escalation_reason")
  escalatedAt      DateTime? @map("escalated_at") @db.Timestamptz(3)

  // Updated on every new message — the sort key for GET /support/conversations
  // (most-recently-active first), unlike Conversation's own list which sorts
  // by createdAt (nothing there ever updates it).
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, lastMessageAt])
  @@map("support_conversations")
}

// One row per turn-participant message: the caller's own, the assistant's
// reply, or a tool's result — never edited after creation, even a FAILED one
// (the outcome is known at persistence time, not discovered afterward).
model SupportMessage {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  role   SupportMessageRole
  status SupportMessageStatus @default(COMPLETED)

  // Null on an ASSISTANT row that only requested tool calls this turn (no
  // text yet), and on a FAILED ASSISTANT row (nothing was generated).
  content String?

  // Only set on an ASSISTANT row that requested tool calls — an array of
  // { id, name, arguments, providerState? }, persisted verbatim.
  // `providerState` is deliberately opaque and vendor-specific (architecture.md
  // §16: "AIToolCall.providerState... newer Gemini models reject a
  // functionCall replayed on a later turn unless its original
  // thought_signature is echoed back") — this service never interprets it,
  // only stores and replays it exactly as the provider returned it.
  toolCalls Json? @map("tool_calls")

  // Only set on a TOOL row — which of the preceding ASSISTANT row's
  // toolCalls this result answers.
  toolCallId String? @map("tool_call_id")

  totalTokens Int? @map("total_tokens")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("support_messages")
}
